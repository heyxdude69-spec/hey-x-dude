# Server-side only. Backend and Next.js must use different ports.
CATALOG_API_ORIGIN=http://127.0.0.1:3000
CATALOG_CONTENT_RATING=general
# Production: set SITE_URL=https://heyxdude.com in Vercel.
SITE_URL=http://localhost:3001
# Same server-only secret as backend. Never use a NEXT_PUBLIC_ variable here.
INTERACTION_PROXY_SECRET=

# Server-only admin panel settings. Never prefix these with NEXT_PUBLIC_.
ADMIN_PANEL_PASSWORD=
ADMIN_PANEL_SESSION_SECRET=
CATALOG_ADMIN_API_TOKEN=

# Exact public image hostnames, comma-separated; no https://, paths or wildcards.
# Configure on Vercel and redeploy to enable remote thumbnail optimization.
# Empty preserves original-image loading. Never put credentials here.
NEXT_PUBLIC_THUMBNAIL_HOSTS=
