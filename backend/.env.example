NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Production: set both SITE_URL and PUBLIC_SITE_URL to https://heyxdude.com.
PUBLIC_SITE_URL=http://localhost:3001
# Must match the frontend's server-only secret (32+ characters).
INTERACTION_PROXY_SECRET=
SITE_URL=http://127.0.0.1:3000
MONGODB_URI=mongodb://127.0.0.1:27017/video_catalog_mongo
MONGODB_POOL_SIZE=40
MONGODB_QUERY_TIMEOUT_MS=3000
# Local development can use bounded in-process caching. Production requires Redis.
REDIS_URL=
CACHE_TTL_SECONDS=90
LOCAL_CACHE_TTL_SECONDS=5
LOCAL_CACHE_MAX_ENTRIES=300
PUBLIC_CACHE_SECONDS=15
RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_REQUESTS=100
TRUST_PROXY_HOPS=0
# Generate a random token before enabling admin writes. Never commit .env.
ADMIN_API_TOKEN=helo123
# Upload keys stay in this API server environment, never in the browser.
PLAYMATE_API_KEY=
VIDARA_API_KEY=
VOE_API_KEY=
LULUSTREAM_API_KEY=
VIDARA_EMBED_TEMPLATE=https://vidara.to/e/{code}
LULUSTREAM_EMBED_TEMPLATE=https://lulust.com/e/{code}
ADMIN_MAX_VIDEO_BYTES=5368709120
ADMIN_TRANSFER_TIMEOUT_SECONDS=1800
# Exact approved URL hostnames; configure real provider embed domains before use.
PROVIDER_HOSTS_JSON={"voe":["voe.sx"],"filemoon":[],"playmate":["playmate.to"],"vidara":["vidara.so","vidara.to"],"lulustream":["lulustream.com","lulust.com"],"direct":["interactive-examples.mdn.mozilla.net"],"reference":[]}
