{
  "name": "slug-video-catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "db:setup": "node scripts/setup_database.mjs",
    "sitemap": "node scripts/build_sitemaps.mjs",
    "worker": "node scripts/catalog_worker.mjs",
    "test": "node --test --test-concurrency=1 tests/catalog.test.mjs tests/category-cards.test.mjs tests/home.test.mjs tests/interaction-access.test.mjs tests/interactions.test.mjs tests/page-seo.test.mjs tests/recommendations.test.mjs tests/search.test.mjs tests/tag.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration.test.mjs",
    "load:test": "node scripts/load_test.mjs",
    "search:setup": "node scripts/setup_search.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.0.0",
    "redis": "^5.8.0",
    "zod": "^4.1.0"
  }
}
